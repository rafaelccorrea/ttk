{
  "name": "pikpok-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Copiloto ao vivo do PikPok — modo somente-painel",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:prod": "cross-env PIKPOK_API_URL=https://ivory-spider-116452.hostingersite.com/api/v1 electron-vite dev",
    "dev:sim": "cross-env PIKPOK_SIMULAR_LIVE=1 PIKPOK_SIM_VIDEO=c:\\Users\\rafae\\Downloads\\videoplayback.mp4 electron-vite dev",
    "dev:sim:prod": "cross-env PIKPOK_SIMULAR_LIVE=1 PIKPOK_SIM_VIDEO=c:\\Users\\rafae\\Downloads\\videoplayback.mp4 PIKPOK_API_URL=https://ivory-spider-116452.hostingersite.com/api/v1 electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "vitest run",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "tiktok-live-connector": "^1.2.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^10.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  },
  "build": {
    "appId": "com.pikpok.desktop",
    "productName": "PikPok Copiloto",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "artifactName": "PikPok-Copiloto-Setup-${version}.${ext}",
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "PikPok Copiloto",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://pikpokviral.com.br/app",
        "channel": "latest"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rafaelccorrea/ttk.git"
  }
}
