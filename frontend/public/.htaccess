# Fallback de SPA.
#
# O React Router resolve /login, /dashboard etc. no navegador, mas esses
# caminhos não existem como arquivo no servidor: um F5 (ou link direto)
# fazia o host responder 404. Aqui qualquer requisição que não case com um
# arquivo ou diretório real cai no index.html, e o roteador assume dali.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivos e diretórios existentes são servidos como estão
  # (assets com hash, favicon, imagens...).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# O index.html não pode ser cacheado: ele referencia os bundles por hash,
# e uma cópia velha aponta para arquivos que não existem mais após um deploy.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Os assets já vêm com hash no nome — podem ser cacheados para sempre.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
