{
  "name": "pikpok-backend",
  "version": "0.1.0",
  "description": "API para insights e tendências de lojas no TikTok",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node src/database/seeds/seed.ts",
    "seed:videos": "ts-node src/database/seeds/seed-videos.ts",
    "seed:creators": "ts-node src/database/seeds/seed-creators.ts",
    "seed:test-user": "ts-node src/database/seeds/seed-test-user.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "stripe:check": "node scripts/stripe-check.js",
    "migration:revert": "npm run typeorm -- migration:revert",
    "cc:login": "node scripts/cc-login.js",
    "purge:scraped": "ts-node src/database/seeds/purge-scraped.ts",
    "shop:login": "node scripts/shop-login.js",
    "shop:register": "node scripts/shop-register.js",
    "purge:seed": "ts-node src/database/seeds/purge-seed.ts",
    "waitlist": "ts-node src/database/seeds/waitlist.ts",
    "waitlist:release": "ts-node src/database/seeds/waitlist.ts",
    "atualiza": "ts-node src/scripts/atualizar.ts",
    "testar:campanhas": "ts-node src/scripts/testar-campanhas.ts",
    "testar:campanhas:completo": "ts-node src/scripts/testar-campanhas.ts --com-ia",
    "atualiza:completo": "ts-node src/scripts/atualizar.ts --completo",
    "zerar:cota": "ts-node src/scripts/zerar-cota.ts",
    "backfill:periodos": "ts-node src/scripts/backfill-periodos.ts",
    "simular:live": "ts-node src/scripts/simular-live.ts",
    "simular:processamento-live": "ts-node src/scripts/simular-processamento-live.ts",
    "live:processar-gravacao": "ts-node src/scripts/processar-gravacao-local.ts",
    "live:extrair-transcricao": "ts-node src/scripts/extrair-da-transcricao.ts",
    "live:base-apresentacao": "ts-node src/scripts/montar-base-apresentacao.ts",
    "seed:personas": "ts-node src/database/seeds/seed-persona-library.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@higgsfield/cli": "^1.1.23",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.11.5",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "typeorm": "^0.3.20",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^jose(/.*)?$": "<rootDir>/../test/jose.stub.js"
    }
  }
}
