# O host define NODE_ENV=production, e o npm reage a isso pulando as
# devDependencies (omit=dev). Só que o build precisa delas: `nest build`
# vem do @nestjs/cli e o tsc precisa do typescript e dos @types/*.
# Sem isto a implantação quebra com "sh: nest: command not found".
# `include` tem precedência sobre `omit`, então isto reativa as devDeps.
include=dev
