# App
PORT=3000
NODE_ENV=development

# Quantos saltos de proxy confiar para descobrir o IP do cliente.
# Isto NAO e afinacao: e o que faz o rate limit funcionar. Sem ele, req.ip e o
# IP do reverse proxy e o app inteiro divide um unico balde de requisicoes —
# um varredor no login tranca a porta de todos os clientes de uma vez.
#   TRUST_PROXY=1        -> um proxy na frente (Nginx, proxy da hospedagem)
#   TRUST_PROXY=2        -> dois (ex.: Cloudflare + Nginx)
#   TRUST_PROXY=loopback -> so 127.0.0.1/::1
#   vazio                -> nao confia em cabecalho nenhum (padrao seguro)
# NUNCA use "true": ele confia no X-Forwarded-For inteiro, inclusive na parte
# que o proprio cliente escreve — e ai o rate limit deixa de existir. A API se
# recusa a subir com esse valor.
TRUST_PROXY=

# Origens extras aceitas no CORS, separadas por virgula (para troca de dominio).
EXTRA_CORS_ORIGINS=

# Database
# Em produção use a connection string do Supabase (Settings > Database > Connection string, modo "Transaction pooler"):
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Se DATABASE_URL estiver vazio, usa o Postgres local (docker compose up -d) com as variáveis DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pikpok

# TLS da conexao com o banco.
# O padrao cifra o trafego mas NAO verifica o certificado do servidor — e
# metade do TLS: protege de quem so escuta, nao de quem se poe no meio. E o que
# passa nessa conexao e o banco inteiro (hashes de senha, creditos, tokens de
# redefinicao). Para fechar, preencha UMA das duas:
#   DB_SSL_CA   -> o PEM da autoridade do provedor, ou o caminho do arquivo.
#                  E o caminho do Supabase, que assina com CA propria:
#                  Settings > Database > SSL Configuration.
#   DB_SSL_MODE=verify -> verifica contra as CAs publicas que o Node ja confia
#                  (para provedores com certificado de CA publica).
# Ligar sem a CA certa nao degrada: derruba a conexao. Por isso o padrao e
# permissivo e o boot avisa em producao.
DB_SSL_CA=
DB_SSL_MODE=

# Supabase Auth
# URL do projeto (Settings > API). Com ela, o backend valida tokens via JWKS.
SUPABASE_URL=
# JWT Secret em Settings > API > JWT Settings do projeto Supabase.
# Com ele preenchido, o backend valida os access tokens emitidos pelo Supabase Auth.
SUPABASE_JWT_SECRET=

# Modo demo (desenvolvimento sem projeto Supabase):
# permite POST /api/v1/auth/dev-login que emite um JWT local assinado com JWT_SECRET.
# NUNCA true em producao: emite token valido para qualquer e-mail, sem senha.
# Com NODE_ENV=production a API recusa subir se isto estiver true.
ALLOW_DEV_LOGIN=true
# Obrigatorio, minimo 32 caracteres. A API se recusa a subir com valor fraco.
# Gere um novo com: openssl rand -hex 32
JWT_SECRET=

# Login com Google (Google Identity Services).
# Client ID do tipo "Web application" criado no Google Cloud Console
# (APIs & Services > Credentials), com as origens do frontend autorizadas
# (http://localhost:5173 em dev, o dominio do app em producao).
# Vazio = o botao "Continuar com Google" nao aparece no frontend.
GOOGLE_CLIENT_ID=

# Swagger fica fora do ar em producao (expoe toda a superficie da API).
# Marque como true so se precisar dele publicado de propósito.
ENABLE_SWAGGER=false
JWT_EXPIRES_IN=7d

# E-mail (Nodemailer) — confirmação de cadastro.
# Sem SMTP_HOST, usa conta de teste Ethereal e loga a URL de preview do e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PikPok" <nao-responda@pikpok.app>
# URL do frontend usada nos links de confirmação
APP_URL=http://localhost:5173

# Higgsfield (geracao de imagem/video por IA) - cloud.higgsfield.ai
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# OpenAI — roteiros, análises, copiloto ao vivo e transcrição (Whisper).
# Sem a chave, os roteiros caem no gerador de template local.
OPENAI_API_KEY=


# Stripe — pagamentos. As chaves saem do dashboard (Developers > API keys).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# URL do app, usada nos redirects de sucesso/cancelamento do checkout.
APP_URL=http://localhost:5173
# Price ids das assinaturas (Products > PikPok Pro / PikPok Business).
# Sem eles o checkout monta o preço inline a partir do billing.config.ts.
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
# Price ids dos pacotes avulsos (pagamento único).
STRIPE_PRICE_PACK_100=
STRIPE_PRICE_PACK_300=
STRIPE_PRICE_PACK_1000=

# Contas de cortesia: sempre no plano Business, sem passar pelo checkout.
# É como as contas da equipe atravessam o paywall — sem isto, na virada nós
# mesmos perdemos o acesso, porque o time entra pelo mesmo login dos clientes.
# Separe por vírgula. Vale só para o plano: créditos de IA continuam sendo
# debitados normalmente, para o uso interno aparecer no relatório de custo.
COMP_ACCOUNT_EMAILS=

# Area administrativa: contas que podem ver e ajustar todos os usuarios, e o
# unico caminho para o modulo de coleta (/ingestion) — que mexe no agendamento
# global de scraping e, antes, bastava ter plano Business para alterar.
# Separe por virgula. Privilegio de admin mora aqui (e nao no banco) para que
# nenhum caminho de escrita em app_users vire escalada de privilegio.
# Esses enderecos tambem recebem o e-mail "Nova conta criada" (precisa de SMTP)
# e veem o toast no painel.
ADMIN_EMAILS=

# Higgsfield — de qual carteira sai a geracao de midia.
# Deixe VAZIO: a escolha e por deteccao — havendo credencial de CLI abaixo, usa
# os creditos do PLANO; nao havendo, usa a chave de API acima, que tem saldo
# proprio e separado. Preencha com 'cli' ou 'api' so para forcar um lado.
HIGGSFIELD_DRIVER=
# Credencial da CLI, gerada por `higgsfield auth login` e copiada para o
# servidor. Sem ela a geração se desliga sozinha (ver a sentinela).
HIGGSFIELD_CREDENTIALS_PATH=
# Alternativa para hospedagem que recria o container e apaga arquivos soltos.
# PREFIRA BASE64: paineis de hospedagem reescrevem JSON colado (chegou com
# barra invertida e sem quebras de linha, e o arquivo saiu corrompido).
#   base64 -w0 ~/.config/higgsfield/credentials.json
# JSON puro e JSON escapado tambem sao aceitos, mas base64 e o unico que
# atravessa qualquer painel sem ser alterado.
HIGGSFIELD_CREDENTIALS_JSON=
# Opcionais — o catálogo muda; confira com `higgsfield model list`.
HIGGSFIELD_CLI_IMAGE_MODEL=nano_banana_2
HIGGSFIELD_CLI_VIDEO_MODEL=kling3_0_turbo
# Frequencia da sentinela (cron). Padrao: a cada minuto.
HIGGSFIELD_SENTINELA_CRON=

# ------------------------------------------------------------
# Fábrica de criativos — geração de vídeo (todas opcionais)
# Modelo padrão por PERFIL de cena (ids em GET /campaigns/video-models):
#   apresentador_fala | apresentador_mudo | tela | produto
# HIGGSFIELD_VIDEO_MODEL_APRESENTADOR_FALA=seedance_2_0
# HIGGSFIELD_VIDEO_MODEL_TELA=kling3_0_turbo
# Padrões gerais (valem quando o perfil não tem variável própria):
# HIGGSFIELD_CLI_VIDEO_MODEL=kling3_0_turbo
# HIGGSFIELD_CLI_SPEECH_VIDEO_MODEL=seedance_2_0
# Quanto custa, em US$, UM crédito do plano Higgsfield (Ultra mensal:
# 129/3000 = 0,043; anual 99/3000 = 0,033). É a base do preço por cena da
# Fábrica (custo × margem 1,4, múltiplos de 5). Mude quando o plano mudar.
# HIGGSFIELD_PLAN_CREDIT_USD=0.043
# Quantas cenas de UMA campanha renderizam ao mesmo tempo (1 = serial):
# CAMPAIGN_RENDER_PARALLEL=3
# Aparelho que aparece nas mãos nas cenas de tela (app/sistema):
# CAMPAIGN_SCREEN_DEVICE=Samsung Galaxy S24 Ultra (flat display, thin symmetric bezels, titanium frame, held vertically)

# ---- Cortes: recursos opcionais (todos degradam sozinhos se faltar rede/binário)
# Import por link (yt-dlp). 0 esconde a aba na tela. Binário: YT_DLP_PATH fixo
# ou baixado do GitHub no primeiro uso para YT_DLP_DIR (padrão: temp do sistema).
CUTS_URL_IMPORT=1
YT_DLP_PATH=
# Padrão: ~/.pikpok-bin (NUNCA /tmp — sem permissão de execução na Hostinger).
YT_DLP_DIR=
# Seguir o rosto no 9:16 (BlazeFace, tfjs em CPU; modelo baixado do TF Hub no
# primeiro uso). 0 desliga e todo corte horizontal sai com fundo desfocado.
CUTS_FACE_TRACKING=1
CUTS_FACE_MODEL_URL=
# YouTube bloqueia IP de datacenter ("not a bot"). Proxy residencial resolve;
# cookies de conta logada funcionam mas arriscam banimento — evitar.
YT_DLP_PROXY=
YT_DLP_COOKIES=
