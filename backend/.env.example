# App
PORT=3000
NODE_ENV=development

# Database
# Em produção use a connection string do Supabase (Settings > Database > Connection string, modo "Transaction pooler"):
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Se DATABASE_URL estiver vazio, usa o Postgres local (docker compose up -d) com as variáveis DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pikpok

# Supabase Auth
# URL do projeto (Settings > API). Com ela, o backend valida tokens via JWKS.
SUPABASE_URL=
# JWT Secret em Settings > API > JWT Settings do projeto Supabase.
# Com ele preenchido, o backend valida os access tokens emitidos pelo Supabase Auth.
SUPABASE_JWT_SECRET=

# Modo demo (desenvolvimento sem projeto Supabase):
# permite POST /api/v1/auth/dev-login que emite um JWT local assinado com JWT_SECRET.
# NUNCA true em producao: emite token valido para qualquer e-mail, sem senha.
# Com NODE_ENV=production a API recusa subir se isto estiver true.
ALLOW_DEV_LOGIN=true
# Obrigatorio, minimo 32 caracteres. A API se recusa a subir com valor fraco.
# Gere um novo com: openssl rand -hex 32
JWT_SECRET=

# Swagger fica fora do ar em producao (expoe toda a superficie da API).
# Marque como true so se precisar dele publicado de propósito.
ENABLE_SWAGGER=false
JWT_EXPIRES_IN=7d

# E-mail (Nodemailer) — confirmação de cadastro.
# Sem SMTP_HOST, usa conta de teste Ethereal e loga a URL de preview do e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PikPok" <nao-responda@pikpok.app>
# URL do frontend usada nos links de confirmação
APP_URL=http://localhost:5173

# Higgsfield (geracao de imagem/video por IA) - cloud.higgsfield.ai
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# OpenAI — roteiros, análises, copiloto ao vivo e transcrição (Whisper).
# Sem a chave, os roteiros caem no gerador de template local.
OPENAI_API_KEY=


# Stripe — pagamentos. As chaves saem do dashboard (Developers > API keys).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# URL do app, usada nos redirects de sucesso/cancelamento do checkout.
APP_URL=http://localhost:5173
# Price ids das assinaturas (Products > PikPok Pro / PikPok Business).
# Sem eles o checkout monta o preço inline a partir do billing.config.ts.
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
# Price ids dos pacotes avulsos (pagamento único).
STRIPE_PRICE_PACK_100=
STRIPE_PRICE_PACK_300=
STRIPE_PRICE_PACK_1000=

# Contas de cortesia: sempre no plano Business, sem passar pelo checkout.
# É como as contas da equipe atravessam o paywall — sem isto, na virada nós
# mesmos perdemos o acesso, porque o time entra pelo mesmo login dos clientes.
# Separe por vírgula. Vale só para o plano: créditos de IA continuam sendo
# debitados normalmente, para o uso interno aparecer no relatório de custo.
COMP_ACCOUNT_EMAILS=

# Area administrativa: contas que podem ver e ajustar todos os usuarios.
# Separe por virgula. Privilegio de admin mora aqui (e nao no banco) para que
# nenhum caminho de escrita em app_users vire escalada de privilegio.
ADMIN_EMAILS=

# Higgsfield — de qual carteira sai a geracao de midia.
# Deixe VAZIO: a escolha e por deteccao — havendo credencial de CLI abaixo, usa
# os creditos do PLANO; nao havendo, usa a chave de API acima, que tem saldo
# proprio e separado. Preencha com 'cli' ou 'api' so para forcar um lado.
HIGGSFIELD_DRIVER=
# Credencial da CLI, gerada por `higgsfield auth login` e copiada para o
# servidor. Sem ela a geração se desliga sozinha (ver a sentinela).
HIGGSFIELD_CREDENTIALS_PATH=
# Alternativa para hospedagem que recria o container e apaga arquivos soltos:
# cole aqui o CONTEUDO do credentials.json. O backend escreve o arquivo no boot,
# e so quando ele nao existe (a CLI o reescreve a cada renovacao do token).
HIGGSFIELD_CREDENTIALS_JSON=
# Opcionais — o catálogo muda; confira com `higgsfield model list`.
HIGGSFIELD_CLI_IMAGE_MODEL=nano_banana_2
HIGGSFIELD_CLI_VIDEO_MODEL=kling3_0_turbo
